# =============================================================================
# Lavoro Esterno - variabili d'ambiente di esempio
# -----------------------------------------------------------------------------
# Copiare questo file in ".env" ("cp .env.example .env") e valorizzare TUTTE
# le variabili prima di avviare "docker compose up".
#
# REGOLA FONDAMENTALE: il file ".env" reale NON va MAI committato nel
# repository (deve restare in .gitignore). Tutti i segreti/password/chiavi
# qui sotto sono placeholder: vanno rigenerati per ogni ambiente (dev,
# staging, produzione) e ruotati periodicamente in produzione.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=lavoro_esterno
POSTGRES_USER=lavoro_esterno
# CAMBIARE in produzione: password forte, generata random (es. `openssl rand -base64 24`)
POSTGRES_PASSWORD=change-me-strong-password

# Stringa di connessione ASYNC (driver asyncpg) usata da FastAPI e da Alembic
# (le migrazioni girano con un engine async, vedi backend/migrations/env.py).
# L'host "postgres" è il nome del servizio nella rete docker-compose interna.
DATABASE_URL=postgresql+asyncpg://lavoro_esterno:change-me-strong-password@postgres:5432/lavoro_esterno
# Stringa di connessione SYNC (driver psycopg2) usata solo dai worker Celery
# per operazioni che non possono girare in un event loop async.
DATABASE_URL_SYNC=postgresql+psycopg2://lavoro_esterno:change-me-strong-password@postgres:5432/lavoro_esterno

# -----------------------------------------------------------------------------
# Redis (broker Celery + cache applicativa)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# MinIO (storage media S3-compatible)
# -----------------------------------------------------------------------------
# CAMBIARE in produzione: credenziali dedicate, non quelle di default MinIO.
# Usate dal SERVER MinIO stesso per l'inizializzazione dell'utente root.
MINIO_ROOT_USER=lavoro_esterno_admin
MINIO_ROOT_PASSWORD=change-me-strong-password
# Credenziali usate dal CLIENT (backend/worker) per autenticarsi a MinIO:
# devono avere lo STESSO valore di MINIO_ROOT_USER/MINIO_ROOT_PASSWORD sopra
# (sono duplicate perché il container minio e il backend leggono nomi env
# diversi: il primo si aspetta MINIO_ROOT_*, il secondo MINIO_ACCESS/SECRET_KEY).
MINIO_ACCESS_KEY=lavoro_esterno_admin
MINIO_SECRET_KEY=change-me-strong-password
# Endpoint interno usato dal backend per parlare con MinIO via rete docker.
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=lavoro-esterno-media
# Se il backend accede via HTTPS (es. dietro proxy TLS terminato altrove),
# impostare a "true"; in sviluppo locale resta "false" (endpoint interno http).
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Deve coincidere con MINIO_SITE_REGION del server. Rende la firma presigned
# locale: il backend non deve contattare l'endpoint pubblico dal container.
MINIO_REGION=us-east-1
MINIO_PRESIGNED_TTL_MINUTES=15

# Media: limiti conservativi e revisione prudenziale
MEDIA_IMAGE_MAX_BYTES=15728640
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_PIXELS=40000000
MEDIA_VIDEO_MAX_SECONDS=300
MEDIA_ORPHAN_GRACE_HOURS=24
MEDIA_EXPLICIT_THRESHOLD=0.65
MEDIA_SAFE_THRESHOLD=0.20
NOTIFICATION_RETENTION_DAYS=90

# Proxy rotator. La chiave e richiesta solo per proxy con username/password.
# Deve essere diversa dalle chiavi telefono/AI: generare 32 byte casuali in base64.
PROXY_CREDENTIAL_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Host proxy privati ammessi esplicitamente (CSV, vuoto = nessuno).
PROXY_PRIVATE_HOST_ALLOWLIST=
PROXY_MAX_ATTEMPTS=3

# Scheduler scraping fixed-delay (il timer parte dalla fine del run precedente).
SCRAPE_PENDING_RETRY_MINUTES=2
SCRAPE_STALE_HOURS=6
SCRAPE_SCHEDULER_BATCH_SIZE=100

# Riepiloghi AI multiprovider. Gemma 4 E2B gira localmente via Ollama.
# Generare AI_CREDENTIAL_ENCRYPTION_KEY con 32 byte casuali in base64 prima
# di salvare API key cloud dalla pagina /settings/ai.
AI_CREDENTIAL_ENCRYPTION_KEY=
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_DEFAULT_MODEL=gemma4:e2b
AI_CUSTOM_ENDPOINT_ALLOWLIST=
AI_MODEL_CATALOG_TTL_SECONDS=300
AI_MAX_OUTPUT_TOKENS=2000
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=100000
# Variabili OpenAI legacy, non usate dalla configurazione runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMPT_VERSION=summary-v1
OPENAI_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Autenticazione JWT
# -----------------------------------------------------------------------------
# CAMBIARE OBBLIGATORIAMENTE in produzione. Generare con:
#   openssl rand -base64 64
# Un'unica chiave simmetrica firma sia gli access token sia i refresh token
# (sono distinti dal claim "type" nel payload, non da chiavi separate).
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# -----------------------------------------------------------------------------
# Rate limiting / lockout su login e verifica 2FA (protezione brute-force,
# contatori tenuti in Redis, vedi app/security/redis_client.py)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Policy password: solo complessità minima, nessuna scadenza forzata
PASSWORD_MIN_LENGTH=12

# -----------------------------------------------------------------------------
# Retention dati (pulizia periodica notturna, vedi
# backend/app/workers/tasks_maintenance.py). Impostare un valore a zero per
# disabilitare esplicitamente la relativa politica di cancellazione.
AUDIT_LOG_RETENTION_DAYS=365
SCRAPE_ERROR_RETENTION_DAYS=90
EXPORT_RETENTION_DAYS=7
ADVERTISEMENT_RETENTION_DAYS=365
MEDIA_RETENTION_DAYS=180
TECHNICAL_LOG_RETENTION_DAYS=90
EXPORT_MAX_RECORDS=1000
EXPORT_MAX_UNCOMPRESSED_BYTES=2147483648
EXPORT_ORPHAN_GRACE_HOURS=24

# -----------------------------------------------------------------------------
# Backup locali (servizi backup-postgres/backup-minio, vedi infra/backup/ e
# docs/DATABASE.md § Backup). Giorni di conservazione dei dump Postgres
# (non si applica al mirror MinIO, che è una replica continua, non snapshot).
BACKUP_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Cifratura dati sensibili (numeri di telefono)
# -----------------------------------------------------------------------------
# PHONE_ENCRYPTION_KEY: chiave AES-256-GCM per la cifratura del numero di
# telefono in chiaro. Deve essere una stringa base64 che decodifica a
# ESATTAMENTE 32 byte. Generarla con:
#   openssl rand -base64 32
# NON riutilizzare la stessa chiave tra ambienti diversi (dev/staging/prod).
# La perdita di questa chiave rende irrecuperabili i dati cifrati esistenti;
# la sua rotazione richiede una migrazione dati dedicata (re-cifratura).
# NOTA: il valore sotto è un placeholder di SOLO SVILUPPO ma DEVE restare
# base64 valido decodificabile a 32 byte esatti (a differenza di altri
# segreti "change-me" di questo file, una stringa arbitraria qui causa un
# crash a runtime — binascii.Error — al primo utilizzo, non un errore di
# validazione pulito): generarne uno nuovo per staging/produzione con il
# comando `openssl rand -base64 32` sopra.
PHONE_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# PHONE_HMAC_SECRET: segreto usato per calcolare l'HMAC-SHA256 del numero di
# telefono normalizzato, usato come indice di lookup/deduplicazione senza
# esporre il numero in chiaro nel database. Generarlo con:
#   openssl rand -base64 32
# Deve rimanere stabile nel tempo (cambiarlo invalida tutti gli hash già
# calcolati e richiede un ricalcolo massivo).
PHONE_HMAC_SECRET=change-me-hmac-secret

# -----------------------------------------------------------------------------
# CORS / Frontend
# -----------------------------------------------------------------------------
# Origine (o lista separata da virgola) autorizzata a chiamare l'API da browser.
CORS_ORIGIN=http://localhost:5173
# Path same-origin dell'API usato dal frontend Docker. In sviluppo Vite
# separato può essere sostituito con un URL assoluto del reverse proxy.
VITE_API_URL=/api/v1

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
# CAMBIARE in produzione: password dell'utente "admin" di Grafana.
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin

# Nome del progetto Compose usato da Alloy per selezionare esclusivamente i
# container di questo stack. Cambiarlo se si avvia Compose con `-p` o con una
# variabile COMPOSE_PROJECT_NAME diversa dal nome predefinito della cartella.
OBSERVABILITY_COMPOSE_PROJECT=lavoro-esterno-1
