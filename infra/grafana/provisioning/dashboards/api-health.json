{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Celery Workers", "type": "link", "url": "/d/lavoro-esterno-celery/celery-workers"},
    {"title": "Scraping Sources", "type": "link", "url": "/d/lavoro-esterno-scraping/scraping-sources"}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto"},
      "targets": [{"expr": "up{job=\"api\"}", "instant": true, "refId": "A"}],
      "title": "API Status",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqpm"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"},
      "targets": [{"expr": "lavoro_esterno:api_requests_per_minute", "instant": true, "refId": "A"}],
      "title": "Requests/min", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 0.02}, {"color": "red", "value": 0.05}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"},
      "targets": [{"expr": "lavoro_esterno:api_server_error_ratio", "instant": true, "refId": "A"}],
      "title": "5xx Error Rate", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"},
      "targets": [{"expr": "lavoro_esterno:api_latency_p95_seconds", "instant": true, "refId": "A"}],
      "title": "Latency p95", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0}, "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto"},
      "targets": [{"expr": "sum(lavoro_esterno_http_requests_inprogress)", "instant": true, "refId": "A"}],
      "title": "Requests in flight", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (method, handler) (rate(lavoro_esterno_http_requests_total[$__rate_interval]))", "legendFormat": "{{method}} {{handler}}", "refId": "A"}],
      "title": "Request rate per route", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (handler, le) (rate(lavoro_esterno_http_request_duration_highr_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{handler}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (handler, le) (rate(lavoro_esterno_http_request_duration_highr_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{handler}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (handler, le) (rate(lavoro_esterno_http_request_duration_highr_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{handler}}", "refId": "C"}
      ],
      "title": "Latency percentiles", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 7, "w": 10, "x": 0, "y": 12}, "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(lavoro_esterno_http_requests_total{status=\"4xx\"}[$__rate_interval])) / clamp_min(sum(rate(lavoro_esterno_http_requests_total[$__rate_interval])), 1e-9)", "legendFormat": "4xx", "refId": "A"},
        {"expr": "sum(rate(lavoro_esterno_http_requests_total{status=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(lavoro_esterno_http_requests_total[$__rate_interval])), 1e-9)", "legendFormat": "5xx", "refId": "B"}
      ],
      "title": "4xx / 5xx error rate", "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 7, "w": 14, "x": 10, "y": 12}, "id": 9,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"expr": "{service=\"api\"}", "refId": "A"}],
      "title": "API logs", "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["lavoro-esterno", "api"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "API Health",
  "uid": "lavoro-esterno-api",
  "version": 1
}
